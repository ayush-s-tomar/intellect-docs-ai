# Copy to .env.local and fill in. Never commit real keys.

# Groq API key (console.groq.com)
GROQ_API_KEY=
# Cohere API key (dashboard.cohere.com)
COHERE_API_KEY=
# Supabase project URL (not a secret)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase service_role key. Server-only. Must be service_role, not anon.
SUPABASE_SERVICE_ROLE_KEY=
# Upstash Redis REST URL and token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret for the daily cleanup cron (any long random string)
CRON_SECRET=
